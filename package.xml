<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>btick</name>
  <version>1.0.0</version>
  <description>BTick - Lightweight client library for ROS 2 BehaviorTree observation and Nav2 logging</description>
  <maintainer email="sheriffathey@outlook.com">Sherif Fathey</maintainer>
  <author email="sheriffathey@outlook.com">Sherif Fathey</author>
  <url type="website">https://github.com/SherifFathey</url>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>std_msgs</depend>
  <depend>pugixml</depend>
  <depend>nlohmann_json</depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
